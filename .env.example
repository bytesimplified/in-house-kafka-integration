# Values are read from the environment; do not commit credentials.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=inhouse-kafka
KAFKA_GROUP_ID=inhouse-kafka-workers
KAFKA_TOPIC=inhouse.events.v1
KAFKA_DLQ_TOPIC=inhouse.events.v1.dlq
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# For SASL_SSL / SASL_PLAINTEXT set all three:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=service-account
# KAFKA_SASL_PASSWORD=from-your-secret-manager
# KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/ca.pem
